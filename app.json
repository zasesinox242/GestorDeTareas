{
  "expo": {
    "name": "parcialmovil",
    "slug": "parcialmovil",
    "version": "1.0.0",
    "scheme": "gestordetareas",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.zasesinox242.gestordetareas",
      "supportsTablet": true
    },
    "android": {
      "package": "com.zasesinox242.gestordetareas",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite el acceso a tus fotos para adjuntarlas a una tarea."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40cc2e66-5763-4d61-9d1e-64aedc663f4a"
      }
    }
  }
}
